# Copy to .env and fill in. .env is gitignored — never commit real values.
# PayPal SANDBOX credentials only. Never a live key.

# offline       the interface runs with no credentials and no payment provider.
# paypal_sandbox  sandbox invoicing is on. Missing credentials FAIL AT STARTUP;
#                 they never fall back to a fake success.
PAYMENTS_MODE=offline

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# off         no model is called; rent splits are typed by a person only.
# anthropic   AI-assisted weight proposals are on. A missing API key FAILS AT
#             STARTUP; it never falls back to a fake proposal. The model only ever
#             returns relative weights and a stated basis — never an amount; see
#             src/ai/proposal.js.
AI_MODE=off

ANTHROPIC_API_KEY=your_anthropic_api_key_here
# The AI never does arithmetic (the deterministic code in src/ai/weights.js does,
# exactly) — this call is paid for judgment about room facts and a basis line a
# tenant would accept, on a request that runs about twice a year per household.
ANTHROPIC_MODEL=claude-opus-5-5

# Local server
DEMO_PORT=8888

# Sandbox recipient addresses are personal account details, not fixture data.
# They go in .hearth-local/sandbox-recipients.json, which is gitignored, and are
# mapped to fictional residents by id. See README.md.

# Hosted (Vercel) only — set these in the project's environment variables, not here.
#   HEARTH_ACCESS_CODE       optional. Leave it unset and the page opens with no code;
#                            set it and the page asks for it.
#   SANDBOX_RECIPIENTS_JSON  the contents of .hearth-local/sandbox-recipients.json
#                            on one line; a hosted function has no local files.
#   DATABASE_URL             set by connecting a Postgres database to the project.
